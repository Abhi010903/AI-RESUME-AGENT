# AI Resume Agent - User Backend Configuration
APP_NAME="AI Resume Agent - User API"
APP_VERSION="0.1.0"
ENV="development"
DEBUG=false

# Server Settings
HOST="0.0.0.0"
PORT=8000

# Logging
LOG_LEVEL="INFO"
LOG_JSON=false

# Database (Default: SQLite for local dev; PostgreSQL supported via connection string)
DATABASE_URL="sqlite:///./resume_agent.db"

# Security & CORS (comma-separated or JSON list of origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Resume Ingestion & Storage Settings
UPLOAD_DIR="storage/uploads"
GENERATED_RESUMES_DIR="storage/generated_resumes"
MAX_UPLOAD_FILE_SIZE=10485760
MAX_UPLOAD_FILES=10
MIN_UPLOAD_FILES=1

# Authentication & JWT Security (Stage 7)
SECRET_KEY="" # Explicitly set in production (minimum 32 characters)
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
