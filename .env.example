# Application Environment Configuration Template
# Copy this file to .env and adjust variables as required.

APP_NAME="AI Resume Agent API"
APP_VERSION="0.1.0"
ENV="development"
DEBUG=true
PORT=8000

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite:///./data.db"
# DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/resume_agent"

# Security & CORS
SECRET_KEY="change-me-to-a-secure-secret-key-at-least-32-chars-long"
CORS_ORIGINS=["http://localhost:3000"]

# Document Ingestion Storage & Limits
UPLOAD_DIR="./storage"
MAX_UPLOAD_FILE_SIZE=10485760  # 10 MB per file
MAX_BATCH_FILES=10

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="text"

# Legacy AI Integration (Optional)
HUGGINGFACE_API_TOKEN=""
